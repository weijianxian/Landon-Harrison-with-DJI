-- Bird DJI HUD: native Fuse controls, no UIManager, external Resolve API or AI nodes.
-- Cache is JSON data only. Never evaluate a cache as Lua code.
FuRegisterClass("BirdDJI", CT_Tool, {
    REGS_Name = "Bird DJI HUD", REGS_Category = "Fuses\\Bird DJI",
    REGS_OpIconString = "DJI", REGS_Company = "bird-dji",
    REGS_OpDescription = "Editable drone HUD from bird-dji analysis JSON",
    REG_Version = 1, REG_NoMotionBlurCtrls = true, REG_NoObjMatCtrls = true,
})

BirdDJI = {}
local B = BirdDJI
local NULL = {}
local function clamp(v,a,b) return math.max(a,math.min(b,v)) end
local function number(v,default)
    if type(v)=="number" and v==v and math.abs(v)<math.huge then return v end
    return default
end
local function utf8char(n)
    if n<128 then return string.char(n) end
    if n<2048 then return string.char(192+math.floor(n/64),128+n%64) end
    if n<65536 then return string.char(224+math.floor(n/4096),128+math.floor(n/64)%64,128+n%64) end
    return string.char(240+math.floor(n/262144),128+math.floor(n/4096)%64,128+math.floor(n/64)%64,128+n%64)
end
function B.decode(text)
    local pos,depth = 1,0
    local parse
    local function space() local _,e=text:find("^[ \t\r\n]*",pos); pos=(e or pos-1)+1 end
    local function fail() error("Invalid JSON at byte "..pos) end
    local function str()
        if text:sub(pos,pos)~='"' then fail() end
        pos=pos+1; local result={}
        while pos<=#text do
            local c=text:sub(pos,pos); pos=pos+1
            if c=='"' then return table.concat(result) end
            if c=='\\' then
                local e=text:sub(pos,pos); pos=pos+1
                local escapes={['"']='"',['\\']='\\',['/']='/',b='\b',f='\f',n='\n',r='\r',t='\t'}
                if e=='u' then
                    local hex=text:sub(pos,pos+3)
                    if not hex:match('^%x%x%x%x$') then fail() end
                    local n=tonumber(hex,16); pos=pos+4
                    if n>=55296 and n<=56319 then
                        if text:sub(pos,pos+1)~='\\u' then fail() end
                        local low=tonumber(text:sub(pos+2,pos+5),16)
                        if not low or low<56320 or low>57343 then fail() end
                        n=65536+(n-55296)*1024+low-56320; pos=pos+6
                    elseif n>=56320 and n<=57343 then fail() end
                    result[#result+1]=utf8char(n)
                elseif escapes[e] then result[#result+1]=escapes[e] else fail() end
            elseif c:byte()<32 then fail()
            else result[#result+1]=c end
        end
        fail()
    end
    parse=function()
        space(); depth=depth+1; if depth>32 then fail() end
        local c=text:sub(pos,pos); local v
        if c=='"' then v=str()
        elseif c=='[' or c=='{' then
            pos=pos+1; v={}; space()
            local closing=c=='[' and ']' or '}'
            if text:sub(pos,pos)~=closing then
                while true do
                    local key
                    if c=='{' then key=str(); space(); if text:sub(pos,pos)~=':' then fail() end; pos=pos+1 end
                    local value=parse()
                    if key then v[key]=value else v[#v+1]=value end
                    space(); local sep=text:sub(pos,pos)
                    if sep==closing then break end
                    if sep~=',' then fail() end
                    pos=pos+1; space()
                end
            end
            pos=pos+1
        elseif text:sub(pos,pos+3)=='null' then pos=pos+4; v=NULL
        elseif text:sub(pos,pos+3)=='true' then pos=pos+4; v=true
        elseif text:sub(pos,pos+4)=='false' then pos=pos+5; v=false
        else
            local token=text:sub(pos):match('^[^,%]}%s]+')
            if not token then fail() end
            local mantissa,exponent=token:match('^(.-)[eE](.*)$')
            mantissa=mantissa or token
            if exponent and not exponent:match('^[+-]?%d+$') then fail() end
            if not (mantissa:match('^%-?%d+$') or mantissa:match('^%-?%d+%.%d+$')) or
                mantissa:match('^%-?0%d') then fail() end
            v=tonumber(token); if not number(v) then fail() end
            pos=pos+#token
        end
        depth=depth-1; return v
    end
    local result=parse(); space(); if pos<=#text then fail() end
    return result
end
function B.fps(value)
    if type(value)=='string' then
        local a,b=value:match('^(%d+)/(%d+)$')
        if a and tonumber(b)>0 then return tonumber(a)/tonumber(b) end
        return tonumber(value)
    end
    return number(value)
end
function B.validate(c)
    assert(type(c)=='table' and c.schema=='bird-dji.fusion.v1','Unsupported cache schema')
    assert(c.coordinates=='normalized-top-left','Unsupported cache coordinates')
    assert(number(c.width,0)>0 and number(c.height,0)>0,'Invalid dimensions')
    assert(number(B.fps(c.fps),0)>0 and number(c.duration,0)>0,'Invalid timing')
    assert(type(c.frames)=='table' and #c.frames>0 and #c.frames==c.frame_count,'Invalid frame count')
    assert(type(c.scans)=='table','Missing scans')
    for i,f in ipairs(c.frames) do
        assert(type(f)=='table' and number(f.time,-1)>=0 and
               math.abs(f.time-(i-1)/B.fps(c.fps))<.00001,'Invalid frame time')
        assert(type(f.look)=='table' and number(f.look[1]) and number(f.look[2]),'Invalid look')
        assert(number(f.pose_scan,-1)>=0 and f.pose_scan%1==0 and f.pose_scan<=#c.scans,'Invalid scan index')
    end
    for _,s in ipairs(c.scans) do
        assert(type(s.points)=='table' and type(s.boxes)=='table','Invalid scan')
        for _,point in ipairs(s.points) do
            assert(type(point)=='table' and number(point[1],-1)>=0 and point[1]<=1 and
                   number(point[2],-1)>=0 and point[2]<=1 and
                   number(point[3],-1)>=0 and point[3]<=1,'Invalid keypoint')
        end
        for _,box in ipairs(s.boxes) do
            assert(type(box)=='table' and number(box.track) and number(box.x1,-1)>=0 and
                   number(box.x2,2)<=1 and box.x1<=box.x2 and number(box.y1,-1)>=0 and
                   number(box.y2,2)<=1 and box.y1<=box.y2,'Invalid person box')
        end
    end
    return c
end

-- The control list is also the pure renderer's defaults; numeric controls are keyframeable.
local controls={}
local function control(page,id,label,default,lo,hi,kind,items)
    controls[#controls+1]={page=page,id=id,label=label,default=default,lo=lo,hi=hi,kind=kind or 'number',items=items}
end
local function n(page,id,label,d,lo,hi) control(page,id,label,d,lo,hi) end
local function toggle(page,id,label,d) control(page,id,label,d,0,1,'toggle') end
local function txt(page,id,label,d) control(page,id,label,d,nil,nil,'text') end
local function color(page,id,label,r,g,b,group)
    for i,part in ipairs({'R','G','B'}) do
        control(page,id..part,label..' '..part,({r,g,b})[i],0,1,'color',{group,i-1,label})
    end
end
